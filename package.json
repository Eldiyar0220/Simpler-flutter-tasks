                "SimplerFlutterTasks.Flavors": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string",
                            "description": "Path to the main file (e.g., lib/main) -- lib/main_prod, lib/main_dev, lib/main_stagging ",
                            "default": "lib/main"
                        },
                        "flavors": {
                            "type": "array",
                            "default": [
                                {
                                    "title": "prod",
                                    "package": "com_packages_of_your_app"
                                },
                                {
                                    "title": "staging",
                                    "package": "com_packages_of_your_app"
                                },
                                {
                                    "title": "dev",
                                    "package": "com_packages_of_your_app"
                                }
                            ],
                            "items": {
                                "type": "object",
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "description": "Flavor title (e.g., prod)"
                                    },
                                    "package": {
                                        "type": "string",
                                        "description": "Package name (e.g., com_packages_of_your_app)"
                                    }
                                },
                                "required": [
                                    "title",
                                    "package"
                                ]
                            }
                        },
                        "commands": {
                            "type": "array",
                            "description": "Commands shown after picking a flavor. Use ${flavor}, ${package}, ${path}.",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "label": {
                                        "type": "string"
                                    },
                                    "command": {
                                        "type": "string"
                                    },
                                    "action": {
                                        "type": "string",
                                        "enum": [
                                            "run",
                                            "openApk",
                                            "openBundle",
                                            "deleteApk",
                                            "separator"
                                        ]
                                    },
                                    "prodOnly": {
                                        "type": "boolean"
                                    },
                                    "afterDelete": {
                                        "type": "boolean"
                                    }
                                }
                            }
                        }
                    },
                    "required": [
                        "path",
                        "flavors"
                    ],
                    "description": "Configuration for Flutter flavors"
                }
            }
        }
    },
    "scripts": {
        "package": "vsce package",
        "release": "vsce publish",
        "lint": "eslint .",
        "pretest": "npm run lint",
        "test": "node ./test/runTest.js"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.1",
        "@types/node": "16.x",
        "@types/vscode": "^1.80.0",

                },
                "SimplerFlutterTasks.installCommand": {
                    "type": "string",
                    "default": "flutter install",
                    "description": "Command of the Flutter Install button, e.g. flutter install --flavor prod"
                },
                "SimplerFlutterTasks.smallApkCommand": {
                    "type": "string",
                    "default": "flutter build apk --split-per-abi",
                    "description": "Command of the Small APK button, e.g. flutter build apk --split-per-abi --flavor prod -t lib/main_prod.dart"
                },
                "SimplerFlutterTasks.easyLocalizationFirst": {
                    "type": "string",
                    "default": "dart run easy_localization:generate -S assets/langs -O lib/langs",
                    "description": "Easy Localizations < codegen_loader.g.dart > if u change the command reload Vs Code"
                },
                "SimplerFlutterTasks.easyLocalizationSecond": {
                    "type": "string",
                    "default": "dart run easy_localization:generate -S assets/langs -f keys -o locale_keys.g.dart",
                    "description": "Easy Localizations < locale_keys.g.dart > if u change the command reload Vs Code"
                },
                "SimplerFlutterTasks.customCommandsList": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "label": {
                                "type": "string",
                                "description": "Label for the Custom Command"
                            },
                            "enabled": {
                                "type": "boolean",
                                "default": true,
                                "description": "Label for the Custom Command"
                            },
                            "archived": {
                                "type": "boolean",
                                "default": false,
                                "description": "Hidden from the status bar and menus; kept in History on the settings panel"
                            },
                            "color": {
                                "type": "string",
                                "default": "white",
                                "format": "color",
                                "description": "Label for the Custom Command"
                            },
                            "command": {
                                "type": "string",
                                "default": "flutter build apk",
                                "description": "Initial state of the Custom Command"
                            },
                            "warningDialog": {
                                "type": "boolean",
                                "default": false,

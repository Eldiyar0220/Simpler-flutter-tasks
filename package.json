                    ],
                    "enumDescriptions": [
                        "Easy Localizations icon -> show",
                        "Easy Localizations icon -> hide"
                    ],
                    "description": "Complete String with hide or show Icon"
                },
                "SimplerFlutterTasks.buildApkCommand": {
                    "type": "string",
                    "default": "flutter build apk",
                    "description": "Command of the Build APK button, e.g. flutter build apk --flavor prod -t lib/main_prod.dart"
                },
                "SimplerFlutterTasks.iosCommand": {
                    "type": "string",
                    "default": "flutter build ios",

{
    "name": "simpler-flutter-tasks",
    "displayName": "Simpler Flutter Tasks",
    "repository": {
        "type": "git",
        "url": "https://github.com/Eldiyar0220/simpler-flutter-tasks"
    },
    "description": "Flutter quick commands",
    "publisher": "Eldiyar-Dev",
    "version": "4.0.4",
    "icon": "images/eldiyar_profile_icon.png",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other",
        "Programming Languages",
        "Snippets",
        "Linters",
        "Formatters",
        "Debuggers",
        "Testing"
    ],
    "keywords": [
        "Flutter",
        "Dart",
        "Snippets",
        "commands",
        "fast commands"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onCommand:flutter-tasks.activateFlavor"
    ],
    "main": "./src/extension.js",
    "enabledApiProposals": [],
    "contributes": {
        "commands": [
            {
                "command": "flutter-tasks.commandsMenu",
                "title": "Commands Menu",
                "category": "Simpler Flutter Tasks",
                "icon": "$(rocket)"
            },
            {
                "command": "flutter-tasks.openSettingsPanel",
                "title": "Open Settings Panel",
                "category": "Simpler Flutter Tasks",
                "icon": "$(settings-gear)"
            },
            {
                "command": "flutter-tasks.showWelcome",
                "title": "Show Welcome / What’s New",
                "category": "Simpler Flutter Tasks"
            },
            {
                "command": "flutter-tasks.openBuild",
                "title": "Open Build (APK / AAB / IPA)",
                "category": "Simpler Flutter Tasks",
                "icon": {
                    "light": "assets/icons/open_ios_ipa_folders.gif",
                    "dark": "assets/icons/open_ios_ipa_folders.gif"
                }
            },
            {
                "command": "flutter-tasks.editLocale",
                "title": "Edit",
                "icon": {
                    "light": "assets/icons/edit_locale.gif",
                    "dark": "assets/icons/edit_locale.gif"
                }
            },
            {
                "command": "flutter-tasks.refreshEntry",
                "title": "Refresh",
                "icon": {
                    "light": "assets/icons/refresh.svg",
                    "dark": "assets/icons/refresh.svg"
                }
            },
            {
                "command": "flutter-tasks.runTheCommand",
                "title": "Run The Command",
                "icon": {
                    "light": "assets/icons/start_black.svg",
                    "dark": "assets/icons/start_icon.svg"
                }
            },
            {
                "command": "flutter-tasks.screenShot",
                "title": "Run The Command",
                "icon": {
                    "light": "assets/icons/flutter_screen_shot_dark.gif",
                    "dark": "assets/icons/flutter_screen_shot.gif"
                }
            },
            {
                "command": "flutter-tasks.doctor",
                "title": "Run The Command",
                "icon": {
                    "light": "assets/icons/flutter_doctor_light.gif",
                    "dark": "assets/icons/flutter_doctor_dark.gif"
                }
            },
            {
                "command": "flutter-tasks.copyTheCommand",
                "title": "Copy"
            },
            {
                "command": "flutter-tasks.openSettingsJson",
                "title": "Open Settings Json",
                "icon": {
                    "light": "assets/icons/code_light.gif",
                    "dark": "assets/icons/settings_hover.gif"
                }
            },
            {
                "command": "flutter-tasks.openSettingsJsonWithIcon",
                "title": "Open Settings Json",
                "icon": {
                    "light": "assets/icons/code_light.gif",
                    "dark": "assets/icons/settings_hover.gif"
                }
            },
            {
                "command": "flutter-tasks.activateCustomCommands",
                "title": "Open Settings Json",
                "icon": {
                    "light": "assets/icons/code_light.gif",
                    "dark": "assets/icons/open_folder_new.gif"
                }
            }
        ],
        "keybindings": [
            {
                "command": "flutter-tasks.activateFlavor",
                "key": "alt+f",
                "when": "editorTextFocus"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "flutter-tasks.openSettingsJson",
                    "when": "editorTextFocus && editorLangId == dart",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "flutter-tasks.runTheCommand",
                    "when": "view == flutter-Commands && viewItem == child || view == flutterView && viewItem == child",
                    "group": "inline"
                },
                {
                    "command": "flutter-tasks.screenShot",
                    "when": "view == flutter-Commands && viewItem == screenShot || view == flutterView && viewItem == screenShot",
                    "group": "inline"
                },
                {
                    "command": "flutter-tasks.doctor",
                    "when": "view == flutter-Commands && viewItem == doctor || view == flutterView && viewItem == doctor",
                    "group": "inline"
                },
                {
                    "command": "flutter-tasks.runTheCommand",
                    "when": "view == flutter-Commands && viewItem == child || viewItem == doctor || viewItem == screenShot"
                },
                {
                    "command": "flutter-tasks.copyTheCommand",
                    "when": "view == flutter-Commands && viewItem == child || viewItem == doctor || viewItem == screenShot || viewItem == copyOnly"
                },
                {
                    "command": "flutter-tasks.openSettingsJsonWithIcon",
                    "when": "view == flutter-Commands && viewItem == settings",
                    "group": "inline"
                },
                {
                    "command": "flutter-tasks.editLocale",
                    "when": "view == flutter-Commands && viewItem == easyLocale",
                    "group": "inline"
                },
                {
                    "command": "flutter-tasks.openBuild",
                    "when": "view == flutter-Commands && viewItem == openBuild || view == flutterView && viewItem == openBuild",
                    "group": "inline"
                },
                {
                    "command": "flutter-tasks.activateCustomCommands",
                    "when": "view == flutter-Commands && viewItem == customCommands",
                    "group": "inline"
                }
            ],
            "view/title": [
                {
                    "command": "flutter-tasks.openSettingsPanel",
                    "when": "view == flutter-Commands",
                    "group": "navigation"
                },
                {
                    "command": "flutter-tasks.refreshEntry",
                    "when": "view == flutter-Commands || view == flutterView",
                    "group": "navigation"
                },
                {
                    "command": "flutter-tasks.openSettingsJson",
                    "when": "view == flutter-Commands || view == flutterView",
                    "group": "navigation"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "flutter-Commands",
                "contents": "Starting…\n\n[Reload Window](command:workbench.action.reloadWindow)"
            },
            {
                "view": "flutterView",
                "contents": "Starting…\n\n[Reload Window](command:workbench.action.reloadWindow)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "flutter-commands-container",
                    "title": "Simpler Flutter Tasks",
                    "icon": "assets/icons/ios_assets.svg"
                }
            ]
        },
        "views": {
            "flutter-commands-container": [
                {
                    "id": "flutter-Commands",
                    "name": "Commands"
                }
            ],
            "explorer": [
                {
                    "id": "flutterView",
                    "name": "Simpler Flutter Tasks 😉"
                }
            ]
        },
        "walkthroughs": [
            {
                "id": "simplerFlutterTasks.customCommands",
                "title": "Custom Commands",
                "description": "How Left/Right, Confirm, Edit first, then-commands and History work.",
                "steps": [
                    {
                        "id": "position",
                        "title": "Left / Right",
                        "description": "The button sits on the left or right of the status bar.\n\nКнопка будет слева или справа на status bar.",
                        "media": {
                            "image": "media/settings_panel/lessons/position.gif",
                            "altText": "Button sliding between left and right of the status bar"
                        }
                    },
                    {
                        "id": "confirm",
                        "title": "Confirm",
                        "description": "VS Code asks “Are you sure?” before the command runs.\n\nПеред запуском спросит «Вы уверены?»",
                        "media": {
                            "image": "media/settings_panel/lessons/confirm.gif",
                            "altText": "Confirm dialog before running a command"
                        }
                    },
                    {
                        "id": "edit",
                        "title": "Edit first",
                        "description": "A text field opens so you can change the command, then it runs.\n\nСначала поле, правите команду, запускается то, что ввели.",
                        "media": {
                            "image": "media/settings_panel/lessons/edit.gif",
                            "altText": "Editing the command in an input box"
                        }
                    },
                    {
                        "id": "then",
                        "title": "Then-command",
                        "description": "Plus adds a command that runs after the main one: main && then.\n\nПлюс добавляет дочернюю команду после основной.",
                        "media": {
                            "image": "media/settings_panel/lessons/then.gif",
                            "altText": "Then-command chained after the main command"
                        }
                    },
                    {
                        "id": "archive",
                        "title": "History",
                        "description": "Remove hides the button. The command stays in History and settings.json.\n\nКрестик убирает кнопку, команда остаётся в истории.",
                        "media": {
                            "image": "media/settings_panel/lessons/archive.gif",
                            "altText": "Command moving from the status bar into History"
                        }
                    }
                ]
            }
        ],
        "configuration": {
            "title": "Simpler Flutter Tasks",
            "properties": {
                "SimplerFlutterTasks.buildRunnerCategoryExpandable": {
                    "type": "boolean",
                    "default": false,
